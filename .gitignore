# =============================
# Unity generated folders (safe to ignore, Unity rebuilds them)
# =============================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Rr]ecordings/
[Uu]serSettings/
[Uu]ser[Ss]ettings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Never ignore Asset meta data from Assets folder
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/[Rr]ider[Aa]ddins.csproj
[Aa]ssets/[Rr]ider[Aa]ddins.csproj.meta

# Visual Studio cache directory
.vs/
.vscode/
*.slnx

# Claude Code local settings
.claude/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Unity's auto-recovery scene backups (created after an unclean shutdown/crash)
[Aa]ssets/_Recovery/
[Aa]ssets/_Recovery.meta

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Android signing keys - NEVER commit these
*.keystore
*.jks

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Android Studio project export backups (Unity creates these next to the
# project root when "Export Project" is used for Android builds - huge,
# regenerable, and explicitly named "don't ship" by Unity itself)
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Burst AOT debug symbols (regenerable, explicitly named "do not ship")
*_BurstDebugInformation_DoNotShip/

# IL2CPP/Android NDK local build cache
.utmp/

# Debug / diagnostic dumps (adb logcat captures)
crash_log*.txt

# Unity Performance Testing auto-generated run artifacts
/Assets/Resources/PerformanceTestRunInfo.json*
/Assets/Resources/PerformanceTestRunSettings.json*

# Phase 6: release keystore credentials - NEVER commit
Keystore/keystore_credentials*.txt

# Build symbol archives and macOS-only Firebase editor plugin (not needed for Android/Windows)
*.symbols.zip
Assets/Firebase/Plugins/x86_64/FirebaseCppApp-*.bundle
Assets/Firebase/Plugins/x86_64/FirebaseCppApp-*.bundle.meta
